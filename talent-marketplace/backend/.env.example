# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (local, Docker, or Atlas)
MONGO_URI=mongodb://localhost:27017/talent-marketplace

# Generate a high-entropy random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_64_char_hex_string
JWT_EXPIRE=15m

# Origin of the frontend app, used for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origin of the frontend app, used to build password-reset links
# (e.g. ${FRONTEND_URL}/reset-password/<token>). Defaults to
# http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# SMTP (all optional). If SMTP_HOST/SMTP_USER/SMTP_PASS are NOT all set,
# the forgot-password feature falls back to logging the reset link to the
# console (see backend/utils/email.js) instead of sending a real email —
# this is the default and keeps password reset fully usable/testable
# without any email provider configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
