# Copy this file to .env and adjust for your local setup.
# Both variables are optional in most setups:
# - In local dev they default to http://localhost:5000 (see src/api/axiosConfig.js and src/pages/Chat.jsx).
# - In the Docker/Nginx production build, requests to /api and /socket.io are
#   proxied same-origin (see nginx.conf), so both can usually stay unset.

# Base URL for REST API calls (must include the /api prefix)
VITE_API_URL=http://localhost:5000/api

# Origin for the Socket.io connection (no /api suffix — this is a bare origin)
VITE_SOCKET_URL=http://localhost:5000
